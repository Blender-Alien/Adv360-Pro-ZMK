#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        inv_1: invert_1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EXCL>, <&kp N1>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        inv_2: invert_2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp AT>, <&kp N2>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        inv_3: invert_3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp HASH>, <&kp N3>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        inv_4: invert_4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOLLAR>, <&kp N4>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        inv_5: invert_5 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PERCENT>, <&kp N5>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        inv_6: invert_6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp CARET>, <&kp N6>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        inv_7: invert_7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp AMPERSAND>, <&kp N7>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        inv_8: invert_8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp STAR>, <&kp N8>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        inv_9: invert_9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LPAR>, <&kp N9>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        inv_0: invert_0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RPAR>, <&kp N0>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp SQT    &inv_1     &inv_2    &inv_3    &inv_4     &inv_5  &tog 1                                                     &mo 3      &inv_6  &inv_7  &inv_8     &inv_9    &inv_0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &mo 1                                                      &none      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp SQT    &kp A      &kp S     &kp D     &kp F      &kp G   &tog 4    &kp ESCAPE  &kp LALT       &kp LGUI   &kp END    &none      &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp EQUAL
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                         &kp HOME       &kp PG_UP                        &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL     &kp LCTRL      &kp PG_DN  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp SQT    &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                     &mo 3      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                      &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp SQT    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp ESCAPE  &kp LALT       &kp LGUI   &kp END    &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp EQUAL
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                         &kp HOME       &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL     &kp LCTRL      &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4          &kp F5      &kp F6  &tog 1                                                &mo 3   &kp F7  &kp F8  &kp F9           &kp F10            &kp F11  &kp F12
&trans  &trans  &trans  &trans          &trans      &trans  &none                                                 &none   &trans  &trans  &trans           &trans             &trans   &trans
&trans  &trans  &trans  &trans          &trans      &trans  &none             &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans           &trans             &trans   &trans
&trans  &trans  &trans  &trans          &trans      &trans                            &trans      &trans                  &trans  &trans  &trans           &trans             &trans   &trans
&trans  &trans  &trans  &kp C_PREVIOUS  &kp C_NEXT          &kp C_PLAY_PAUSE  &trans  &trans      &trans  &trans  &trans          &trans  &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        gaming {
            display-name = "Red";
            bindings = <
&kp SQT    &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &none                                                       &mo 3          &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                       &none          &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp SQT    &kp A      &kp S     &kp D     &kp F      &kp G   &trans     &kp ESCAPE  &kp LALT       &kp LGUI   &kp END    &none          &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp EQUAL
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                          &kp HOME       &kp PG_UP                            &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp SPACE  &kp DEL     &kp LCTRL      &kp PG_DN  &kp ENTER  &kp BACKSPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 2
            >;
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
